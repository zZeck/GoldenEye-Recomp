{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-amd64",
            "displayName": "Windows AMD64 (llvm-mingw cross-compile)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchain-llvm-mingw-x86_64.cmake",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION_DEBUG": "OFF",
                "REXSDK_DIR": "${sourceDir}/GoldenEye-Recomp-rexglue"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-amd64",
            "displayName": "Linux AMD64 (native clang)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "REXSDK_DIR": "${sourceDir}/GoldenEye-Recomp-rexglue"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-amd64-debug",
            "displayName": "Windows AMD64 Debug",
            "configurePreset": "win-amd64",
            "configuration": "Debug"
        },
        {
            "name": "win-amd64-release",
            "displayName": "Windows AMD64 Release",
            "configurePreset": "win-amd64",
            "configuration": "Release"
        },
        {
            "name": "win-amd64-relwithdebinfo",
            "displayName": "Windows AMD64 RelWithDebInfo",
            "configurePreset": "win-amd64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-debug",
            "displayName": "Linux AMD64 Debug",
            "configurePreset": "linux-amd64",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-release",
            "displayName": "Linux AMD64 Release",
            "configurePreset": "linux-amd64",
            "configuration": "Release"
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "displayName": "Linux AMD64 RelWithDebInfo",
            "configurePreset": "linux-amd64",
            "configuration": "RelWithDebInfo"
        }
    ]
}
